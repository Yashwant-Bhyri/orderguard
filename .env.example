# Variable names only. Copy to .env (git-ignored) or to a file outside the repository and point OG_ENV_FILE at it.
# Never put a real key in this file. `orderguard init` writes the same template into your config directory.
# Provider: deepseek (default, DeepSeek's own API, key DEEPSEEK_API_KEY) or openrouter (key OPENROUTER_API_KEY)
OG_PROVIDER=deepseek
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# live | replay (replay never calls a model and never spends)
OG_LLM=live
# Hard spend ceiling for model calls, in USD
OG_BUDGET_USD=0.05
# Bearer token the web app requires. Generate a long random string; required before exposing the app beyond loopback.
ORDERGUARD_APP_TOKEN=
# Receiver bridge base URL, e.g. http://127.0.0.1:8700. Empty = no receiver (local paper ledger fallback).
ORDERGUARD_RECEIVER_URL=
# Optional
OG_MODEL=deepseek/deepseek-v4.1-flash-1017
OG_SEC_UA=OrderGuard research prototype
