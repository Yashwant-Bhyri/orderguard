          {
            "in": "query",
            "name": "agents",
            "required": false,
            "schema": {
              "default": "150",
              "title": "Agents",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "steps",
            "required": false,
            "schema": {
              "default": "400",
              "title": "Steps",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "routing",
            "required": false,
            "schema": {
              "default": "pinned",
              "pattern": "^(pinned|tightest_fit)$",
              "title": "Routing",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "agent_share",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 1,
                  "type": "number"
                },
                {
                  "type": "null"
