{
  "components": {
    "schemas": {
      "CheckOrderRequest": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "default": "2024-11-06",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "As Of",
            "type": "string"
          },
          "daily_total_usd": {
            "default": 0.0,
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Daily Total Usd",
            "type": "number"
          },
          "mandate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MandateUpload"
              },
              {
                "type": "null"
              }
            ]
          },
          "order": {
            "additionalProperties": true,
            "title": "Order",
            "type": "object"
          },
          "prices": {
            "anyOf": [
              {
                "additionalProperties": {
                  "exclusiveMaximum": 1000000000.0,
                  "exclusiveMinimum": 0.0,
                  "type": "number"
                },
                "maxProperties": 500,
                "propertyNames": {
                  "maxLength": 16
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "trusted prices, e.g. {'AAPL': 222.7}; default: the demo market",
            "title": "Prices"
          },
          "require_figures": {
            "default": false,
            "title": "Require Figures",
            "type": "boolean"
          }
        },
        "required": [
          "order"
        ],
        "title": "CheckOrderRequest",
        "type": "object"
      },
      "DraftReviewRequest": {
        "additionalProperties": false,
        "properties": {
          "draft": {
            "additionalProperties": true,
            "title": "Draft",
            "type": "object"
          },
          "purpose": {
            "description": "what the draft is for, in the author's words",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "source": {
            "default": "demo",
            "enum": [
              "demo",
              "configured"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "draft",
          "purpose"
        ],
        "title": "DraftReviewRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MandateUpload": {
        "additionalProperties": false,
        "properties": {
          "mandate": {
            "additionalProperties": true,
            "title": "Mandate",
            "type": "object"
          },
          "public_key": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "base64 Ed25519 public key; without it only integrity is checked",
            "title": "Public Key"
          }
        },
        "required": [
          "mandate"
        ],
        "title": "MandateUpload",
        "type": "object"
      },
      "OrderLine": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "anyOf": [
              {
                "maxLength": 40,
                "pattern": "^[A-Za-z0-9._-]+$",
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent"
          },
          "limit_price": {
            "exclusiveMaximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Limit Price",
            "type": "number"
          },
          "notional_usd": {
            "anyOf": [
              {
                "maximum": 1000000000000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "order value at the trusted price; default quantity x trusted price (or limit price)",
            "title": "Notional Usd"
          },
          "quantity": {
            "exclusiveMaximum": 1000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "type": "number"
          },
          "side": {
            "enum": [
              "buy",
              "sell"
            ],
            "title": "Side",
            "type": "string"
          },
          "step": {
            "anyOf": [
              {
                "maximum": 1000000000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          },
          "ticker": {
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Ticker",
            "type": "string"
          },
          "trusted_price": {
            "anyOf": [
              {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trusted Price"
          }
        },
        "required": [
          "ticker",
          "side",
          "quantity",
          "limit_price"
        ],
        "title": "OrderLine",
        "type": "object"
      },
      "PolicyLimits": {
        "additionalProperties": false,
        "properties": {
          "bad_allowed_usd_per_day": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bad Allowed Usd Per Day"
          },
          "false_refusal_rate": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "False Refusal Rate"
          },
          "holds_per_day": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Holds Per Day"
          }
        },
        "title": "PolicyLimits",
        "type": "object"
      },
      "PolicyRequest": {
        "additionalProperties": false,
        "properties": {
          "agents": {
            "default": 150,
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Agents",
            "type": "integer"
          },
          "draft": {
            "additionalProperties": true,
            "title": "Draft",
            "type": "object"
          },
          "feed": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feed"
          },
          "limits": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolicyLimits"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "default": "fit",
            "enum": [
              "fit",
              "estimate",
              "simulate"
            ],
            "title": "Mode",
            "type": "string"
          },
          "regime": {
            "default": "normal",
            "enum": [
              "normal",
              "volatile",
              "poisoned",
              "collusion"
            ],
            "title": "Regime",
            "type": "string"
          },
          "seed": {
            "default": 7,
            "exclusiveMaximum": 4294967296.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "source": {
            "default": "demo",
            "enum": [
              "demo",
              "configured"
            ],
            "title": "Source",
            "type": "string"
          },
          "steps": {
            "default": 400,
            "maximum": 2000.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          }
        },
        "required": [
          "draft"
        ],
        "title": "PolicyRequest",
        "type": "object"
      },
      "PolicySearchRequest": {
        "additionalProperties": false,
        "properties": {
          "agents": {
            "default": 150,
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Agents",
            "type": "integer"
          },
          "feed": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feed"
          },
          "limits": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolicyLimits"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "default": "simulate",
            "enum": [
              "rank",
              "simulate"
            ],
            "title": "Mode",
            "type": "string"
          },
          "regime": {
            "default": "normal",
            "enum": [
              "normal",
              "volatile",
              "poisoned",
              "collusion"
            ],
            "title": "Regime",
            "type": "string"
          },
          "seed": {
            "default": 7,
            "exclusiveMaximum": 4294967296.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "source": {
            "default": "demo",
            "enum": [
              "demo",
              "configured"
            ],
            "title": "Source",
            "type": "string"
          },
          "steps": {
            "default": 400,
            "maximum": 2000.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          }
        },
        "title": "PolicySearchRequest",
        "type": "object"
      },
      "ReviewContext": {
        "additionalProperties": false,
        "properties": {
          "agent_recent": {
            "description": "this agent's most recent orders, oldest first",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "maxItems": 20,
            "title": "Agent Recent",
            "type": "array"
          },
          "envelope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewEnvelope"
              },
              {
                "type": "null"
              }
            ]
          },
          "tape": {
            "description": "recent orders by all agents on the same ticker, oldest first",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "maxItems": 50,
            "title": "Tape",
            "type": "array"
          }
        },
        "title": "ReviewContext",
        "type": "object"
      },
      "ReviewEnvelope": {
        "additionalProperties": false,
        "properties": {
          "band_pct": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Band Pct"
          },
          "daily": {
            "anyOf": [
              {
                "maximum": 1000000000000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 40,
                "pattern": "^[A-Za-z0-9 ._-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "per_order": {
            "anyOf": [
              {
                "maximum": 1000000000000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Per Order"
          },
          "step_up": {
            "anyOf": [
              {
                "maximum": 1000000000000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step Up"
          }
        },
        "title": "ReviewEnvelope",
        "type": "object"
      },
      "RiskInput": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "anyOf": [
              {
                "enum": [
                  "none",
                  "hold",
                  "refuse"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "reasons": {
            "items": {
              "maxLength": 500,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Reasons",
            "type": "array"
          },
          "risk": {
            "description": "the order-risk model's probability that the order is bad",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk",
            "type": "number"
          }
        },
        "required": [
          "risk"
        ],
        "title": "RiskInput",
        "type": "object"
      },
      "ScenarioRequest": {
        "additionalProperties": false,
        "properties": {
          "arm": {
            "anyOf": [
              {
                "enum": [
                  "naive",
                  "gate_only",
                  "full"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arm"
          },
          "scenario": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Scenario",
            "type": "string"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "ScenarioRequest",
        "type": "object"
      },
      "ScreenRequest": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "tool",
            "enum": [
              "doc",
              "web",
              "feed",
              "tool"
            ],
            "title": "Kind",
            "type": "string"
          },
          "text": {
            "maxLength": 100000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ScreenRequest",
        "type": "object"
      },
      "TriageRequest": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "held_order": {
            "$ref": "#/components/schemas/OrderLine"
          },
          "risk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RiskInput"
              },
              {
                "type": "null"
              }
            ],
            "description": "the risk model's result for this order, merged into p_bad by noisy-OR"
          }
        },
        "required": [
          "held_order"
        ],
        "title": "TriageRequest",
        "type": "object"
      },
      "TriggerGraphRequest": {
        "additionalProperties": false,
        "properties": {
          "blast_source": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blast Source"
          },
          "events": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "maxItems": 2000,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Events"
          },
          "lies": {
            "description": "percent moves a lying source reports (-100..1000)",
            "items": {
              "maximum": 1000.0,
              "minimum": -100.0,
              "type": "number"
            },
            "maxItems": 12,
            "title": "Lies",
            "type": "array"
          },
          "preset": {
            "anyOf": [
              {
                "enum": [
                  "honest",
                  "single_venue_crash",
                  "real_crash",
                  "takeover_echo"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preset"
          },
          "quarantined_sources": {
            "items": {
              "maxLength": 80,
              "type": "string"
            },
            "maxItems": 50,
            "title": "Quarantined Sources",
            "type": "array"
          },
          "rules": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "maxItems": 50,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "rule specs; default: the three standing rules",
            "title": "Rules"
          }
        },
        "title": "TriggerGraphRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "OrderGuard",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/arena/envelopes": {
      "get": {
        "operationId": "arena_envelopes_api_arena_envelopes_get",
        "parameters": [
          {
            "in": "query",
            "name": "agents",
            "required": false,
            "schema": {
              "default": "150",
              "title": "Agents",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ticker",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ticker"
            }
          },
          {
            "in": "query",
            "name": "side",
            "required": false,
            "schema": {
              "default": "buy",
              "title": "Side",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "quantity",
            "required": false,
            "schema": {
              "default": 10,
              "title": "Quantity",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit Price"
            }
          },
          {
            "in": "query",
            "name": "price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Price"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Arena Envelopes Api Arena Envelopes Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Arena Envelopes",
        "tags": [
          "arena"
        ]
      }
    },
    "/api/arena/feeds": {
      "get": {
        "operationId": "arena_feeds_api_arena_feeds_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Arena Feeds Api Arena Feeds Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Arena Feeds",
        "tags": [
          "arena"
        ]
      }
    },
    "/api/arena/frontier": {
      "get": {
        "operationId": "arena_frontier_api_arena_frontier_get",
        "parameters": [
          {
            "in": "query",
            "name": "seed",
            "required": false,
            "schema": {
              "default": "7",
              "title": "Seed",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "agents",
            "required": false,
            "schema": {
              "default": "150",
              "title": "Agents",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "steps",
            "required": false,
            "schema": {
              "default": "400",
              "title": "Steps",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "samples",
            "required": false,
            "schema": {
              "default": 40,
              "maximum": 120,
              "minimum": 8,
              "title": "Samples",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "max_leak",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Leak"
            }
          },
          {
            "in": "query",
            "name": "max_approvals",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Approvals"
            }
          },
          {
            "in": "query",
            "name": "max_false_refusal",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": 0.05,
              "title": "Max False Refusal"
            }
          },
          {
            "in": "query",
            "name": "feed",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Feed"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Arena Frontier Api Arena Frontier Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Arena Frontier",
        "tags": [
          "arena"
        ]
      }
    },
    "/api/arena/policy": {
      "get": {
        "description": "Read the signed parent limits and an editable starting draft.",
        "operationId": "policy_parent_api_arena_policy_get",
        "parameters": [
          {
            "in": "query",
            "name": "source",
