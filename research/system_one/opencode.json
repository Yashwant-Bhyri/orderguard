{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  },
  "snapshot": false,
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "git *": "deny",
      "git": "deny",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny"
    }
  }
}