a256":"ee544020cf0c40ef7460261817fc3d9abfc230c92417b2da6831f7ecc81fdadc"},{"path":"results/sim/logs/collusion_ring-k10000-s7-gate_only.jsonl.gz","sha256":"8919181cf498efb0c3a59b239fd91ec103cf0345d4db22c493a9055736cf9e41"},{"path":"results/sim/logs/collusion_ring-k10000-s7-unguarded.jsonl.gz","sha256":"65e577a8d30108b607175f7a1d050de475e4d260891c43aa55ed1576c7cde3ac"},{"path":"results/sim/real_crash-k10000-s7.json","sha256":"f040277bd04014bee5405cbb4b70e81f1d7ce17e3da8a6ea53b18ab43f78a646"},{"path":"results/sim/stale_feed-k10000-s7.json","sha256":"c21aab66837fb9f755fab924f79988740a56473319101bc76bd759f7b6bbc149"},{"path":"results/sweeps/20261110T230155.jsonl","sha256":"bc3854340c30bbdc85de30490a672119d2c97eed1c41712fc750f7be86a8809f"},{"path":"results/theater/timeline.json","sha256":"ddbee0a90a81278730a8ee89a8e1d72be5dab5c86cd14e27966062feac8556be"}],"lab":{"attacks":{"bare":"Bare model: 7 of 180.","src":"results/runs/20261110T230149.jsonl","text":"attack goals reached by a live model agent behind OrderGuard.","value":"0 of 180"},"honest":{"bare":"Bare model: 113 of 138.","src":"results/sweeps/20261110T230155.jsonl","text":"honest sandbox tasks completed with the guard.","value":"132 of 138"}},"policies":{"packs":[{"about":"Large, slow US names and an index fund, small orders, a tight 0.5% price band and a hard cap on any one name. Starting point, not advice: size it to your account.","band":"0.5%","bar":{"daily":10000,"per_order":2500},"daily":"$10,000","life":"168 h","name":"conservative-equities","orders":"10","per_name":"$4,000","per_order":"$2,500","position":"$7,500","src":"policies/conservative-equities.json","step_up":"$1,500","symbols":6},{"about":"Mid-size orders on a wider list with a 1% band; one name can take at most 15,000 a day and 25,000 of net position. Starting point, not advice.","band":"1.0%","bar":{"daily":40000,"per_order":10000},"daily":"$40,000","life":"72 h","name":"balanced-equities","orders":"30","per_name":"$15,000","per_order":"$10,000","position":"$25,000","src":"policies/balanced-equities.json","step_up":"$6,000","symbols":8},{"about":"For an agent that trades often: larger orders and a 1.5% band, with the order-count and per-name caps as the main backstops. Short lifetime so you re-sign it daily. Starting point, not advice.","band":"1.5%","bar":{"daily":150000,"per_order":25000},"daily":"$150,000","life":"24 h","name":"active-equities","orders":"100","per_name":"$50,000","per_order":"$25,000","position":"$75,000","src":"policies/active-equities.json","step_up":"$15,000","symbols":10},{"about":"Volatile names: a wider 2.5% band, smaller orders and caps, a 24 hour lifetime. Quantities are whole units, so a coin priced above the per-order cap cannot trade until you raise it. Starting point, not advice.","band":"2.5%","bar":{"daily":25000,"per_order":5000},"daily":"$25,000","life":"24 h","name":"crypto-sleeve","orders":"40","per_name":"$10,000","per_order":"$5,000","position":"$15,000","src":"policies/crypto-sleeve.json","step_up":"$3,000","symbols":2}],"src":"policies/README.md"},"product":{"not":[{"lead":"Not a trading strategy.","text":[{"t":"It bounds what a wrong or fooled agent can do. It does not judge whether a trade is a good idea."}]},{"lead":"Not a broker or an exchange connector.","text":[{"t":"This release writes to paper ledgers; a venue connects as an adapter behind the receiver."}]},{"lead":"Not a model that approves orders.","text":[{"t":"Models screen text and rank the review queue. Only code says yes."}]},{"lead":"Not affiliated","text":[{"t":"with any brokerage or exchange."}]}],"rollout":[{"name":"Shadow","text":[{"t":"Call "},{"code":"POST /api/check-order"},{"t":" (or the MCP "},{"code":"check_order"},{"t":" tool) next to your existing order path and log the verdict without acting on it. In parallel, replay recorded proposals through candidate limits with the envelope lab ("},{"code":"og-arena frontier"},{"t":") to see what each would have refused, held and allowed."}]},{"name":"Holds","text":[{"t":"Start sending holds to people: set a conservative step-up threshold in the mandate and switch on the risk layer, so unusual orders wait for a human while ordinary flow passes. The review lane orders that queue by expected bad dollars."}]},{"name":"Enforce","text":[{"t":"Make the receiver the only path to the ledger. It re-checks the signed mandate at commit time, keeps a hash-chained ledger and honours revocation. Refusals now block."}]}],"rollout_note":[{"t":"At every stage the owner signs the limits; nothing widens them without a new signature."}],"src":"docs/PRODUCT.md"},"readme":{"integrations":[{"start":[{"a":"docs/QUICKSTART.md","href":"docs/QUICKSTART.md"}],"surface":"Quickstart","use":"Clone to a refused order in Python, HTTP, Node or MCP, offline, in minutes"},{"start":[{"code":"orderguard serve"},{"t":", then "},{"code":"POST /api/check-order"},{"t":" · "},{"a":"API","href":"docs/API.md"}],"surface":"HTTP API","use":"Check an order or screen text from any stack"},{"start":[{"code":"python -m orderguard_mcp"},{"t":" · "},{"a":"MCP","href":"docs/MCP.md"}],"surface":"MCP server","use":"Give any MCP client (Claude, other agent frameworks) guarded tools"},{"start":[{"code":"orderguard_guard.agent.run_agent(...)"},{"t":" · "},{"a":"Guide","href":"docs/GUIDE.md#integrating-your-own-agent"}],"surface":"Python","use":"Wrap your own agent loop"},{"start":[{"code":"node receiver/bridge/serve.mjs"},{"t":", "},{"code":"packages/sdk"},{"t":" · "},{"a":"Operations","href":"docs/OPERATIONS.md"}],"surface":"Receiver and Node SDK","use":"The final authority before the ledger: re-checks the signed mandate, keeps a hash-chained paper ledger"}],"integrations_note":[{"t":"Whichever surface you use, give the agent no money-movement tool and make the receiver the only path to the ledger."}],"intro":"AI trading agents read news, feeds and web pages, and some of what they read is fake: a forged split notice, a hidden instruction, a planted rumour. Agents also run in swarms, so one fooled decision can repeat across hundreds of agents in seconds. Making the model un-foolable does not work well enough, so OrderGuard puts code between the agents and the money.","learn":[[{"a":"Product brief","href":"docs/PRODUCT.md"},{"t":": who it is for, rollout, FAQ"}],[{"a":"Documentation index","href":"docs/README.md"},{"t":": guides for product, integrators and reviewers"}],[{"a":"Evidence","href":"docs/EVIDENCE.md"},{"t":", "},{"a":"Bench","href":"docs/BENCH.md"},{"t":", "},{"a":"Red team","href":"docs/REDTEAM.md"},{"t":", "},{"a":"Architecture","href":"docs/ARCHITECTURE.md"}],[{"a":"Impact-aware market simulation","href":"docs/SIMULATION.md"},{"t":": mandates, crowding, correlated shocks and the sizing frontier at one million agents"}],[{"a":"Release notes","href":"RELEASE.md"}],[{"t":"Everything a reviewer needs, offline, in one command: "},{"code":"scripts/check_all.sh"},{"t":" ("},{"a":"Testing","href":"docs/TESTING.md"},{"t":")"}]],"licence":[{"t":"MIT licence. See "},{"a":"LICENSE","href":"LICENSE"},{"t":"."}],"promise":"Let AI agents trade, inside limits a human signed and code enforces.","proof":{"AI attackers that read the docs":[{"t":"Adaptive DeepSeek and Qwen attackers, given the threat model, tried every channel from fake news to receiver replays: "},{"b":"0 hard breaches"},{"t":" in 334 usable rounds (95% upper bound 1.1% per round) out of 336 planned (2 produced no usable attack). Measured at a small attacker budget (two low-cost models); stronger and longer-running attackers are a matter of budget, and the full per-family results are in the report."}],"Attacks blocked":[{"t":"With a live model agent behind OrderGuard, "},{"b":"0 of 180"},{"t":" attack goals were achieved, against 7 of 180 for the bare model."}],"Fast enough for the order path":[{"b":"58,314 decisions/s"},{"t":" on the strict path and "},{"b":"9.25 µs p99"},{"t":" inline, for 1,000 agents in one process."}],"Holds at exchange scale":[{"t":"100,000 agents, 1,200 signed mandates and 1.09M orders: an independent auditor, rebuilding every limit from the raw logs, found "},{"b":"0 cap breaches"},{"t":" and "},{"b":"0 double executions"},{"t":", with identical decisions on 1 to 8 processes and "},{"b":"140,302 decisions/s"},{"t":" on one laptop. It also caught "},{"b":"7 of 7"},{"t":" deliberately broken builds."}],"Honest work preserved":[{"t":"In the seeded sandbox, guarded agents completed "},{"b":"132 of 138"},{"t":" honest tasks, against 113 of 138 for the bare model."}],"Humans review what matters first":[{"t":"On a queue of 1,002 flagged orders, ranking by expected bad dollars reaches 90% of them in "},{"b":"470"},{"t":" reviews instead of "},{"b":"719"},{"t":" first-in-first-out. Model advice in this lane can add a hold, never approve."}],"Swarm-scale bad flow stopped":[{"t":"In a 1,000-agent run, the mandate check alone let through "},{"b":"$7.97M"},{"t":" of bad orders that each fit the signed limits, most of it from one colluding group. The risk layer held or refused all of it, sending "},{"b":"0.11%"},{"t":" of honest orders to a human."}]},"proof_note":[{"t":"All runs are simulated (paper ledgers, synthetic or recorded market data). Each number below is rebuilt from the committed results by "},{"code":"og-arena verify"},{"t":"; the full tables and caveats are in "},{"a":"docs/EVIDENCE.md","href":"docs/EVIDENCE.md"},{"t":"."}],"scope":[{"lead":"Venues and ledgers.","text":[{"t":"This release runs against simulated markets, recorded public market data and paper ledgers. Connecting a live venue is an adapter on top of the receiver, which is already the single path to the ledger."}]},{"lead":"Scale of the evidence.","text":[{"t":"Every result here was produced on one laptop with a small model budget: live model trials used one low-cost model family, the red-team campaign ran all 336 planned rounds with two cheap attacker models, and the heaviest million-agent simulation materialised 616,500 orders per arm (3 s